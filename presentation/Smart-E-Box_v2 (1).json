    {
      "parameters": {
        "jsCode": "const lines = $input.first().json.data.split('\\n').filter(l => l.trim());\nreturn lines.map(l => {\n  const m = JSON.parse(l).messages;\n  const label = JSON.parse(m.find(x => x.role === 'assistant').content);\n  const text = m.find(x => x.role === 'user').content;\n\n  const subject = text.split('\\n')[0].replace('Subject: ', '');\n  const body = text.split('\\nBody: ').slice(1).join('\\nBody: ');\n\n  return { json: {\n    subject: subject,\n    body: body,\n    category: label.category,\n    priority: label.priority,\n    action: label.action\n  }};\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -128,
        176
      ],
      "id": "0d4f6cdc-21e3-411b-b712-3cbc99ddc17b",
      "name": "Extract fields"
