    {
      "parameters": {
        "jsCode": "const maxPerCategory = 3;\nconst counts = {};\n\nreturn items.filter(item => {\n  const category = item.json.category;\n\n  if (!category) return false;\n\n  counts[category] = (counts[category] || 0) + 1;\n\n  return counts[category] <= maxPerCategory;\n});"
      },
